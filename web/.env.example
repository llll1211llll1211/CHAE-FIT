# Claude API — 이력서 분석(F2) / 공고 파싱·요약(F3·F5) / 근거 문장(F4)
#
# **없어도 동작한다.** 키가 없으면 세 라우트가 자동으로 목업 응답을 낸다
# (web/src/lib/api/contract.js 의 USE_MOCK). 목업도 실제와 같은 스키마이므로
# 키를 넣는 순간 프론트 코드는 한 줄도 바뀌지 않는다.
#
# 적합도 점수 · 충족/필요 역량은 목업이 아니라 실제 집합 연산이다.
# 키가 없어도 그 값들은 진짜다(PRD §8.4).
ANTHROPIC_API_KEY=

# ── 아래는 MVP 범위 밖 ─────────────────────────────────
# 고용24(워크넷) 오픈API — 공고 탐색 F7. PRD §11에서 "배포 후"로 미뤘다.
# src/lib/jobs/ 는 그 준비 코드이며, 키가 없으면 fixture로 동작한다.
WORK24_USE_FIXTURE=true
WORK24_API_KEY=

# 데모 프리필 — 화면이 열릴 때 샘플 이력서·공고가 이미 채워져 있게 한다.
# 값을 주지 않으면 개발 환경에서만 켜진다. 배포된 데모에서 켜려면 1, 끄려면 0.
# 실서비스에서는 반드시 0으로 둔다 (남의 이력서가 올라가 있는 화면으로 보인다).
NEXT_PUBLIC_DEMO_PREFILL=
